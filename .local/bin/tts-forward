#!/usr/bin/env bash
# tts-forward — edge_tts CLI lookalike backed by https://tts-tts-ingress.tailf0b7b1.ts.net
#
# Accepts the flags the opencode-tts plugin passes its "edge_tts" backend:
#   --text T --write-media OUT --voice V --rate R --volume P
# and synthesizes on the https://tts-tts-ingress.tailf0b7b1.ts.net server instead of locally, so no
# models are needed on this machine. Install (see /install):
#
#   curl -fsSL https://tts-tts-ingress.tailf0b7b1.ts.net/install/tts-forward -o ~/.local/bin/tts-forward
#   chmod +x ~/.local/bin/tts-forward
#
# then point opencode-tts's edge_tts.command at ~/.local/bin/tts-forward.
# TTS_SERVER_URL (or TTS_FORWARD) overrides the baked-in server URL;
# VOICEVOX_VOICE overrides --voice, exactly like the local shim.
#
# --speak, or TTS_FORWARD_MODE=speak, hits /speak instead of /api/tts: the
# server plays it itself ($TTS_PLAY_CMD) and/or pushes it to any browser tab
# listening on /api/events, rather than handing back a WAV for the caller to
# play. The env var is for setting one default globally (e.g. in .profile,
# so opencode-tts's own calls get it too, not just direct command-line use)
# --write-media becomes optional (direct use needs no file at all); for a
# caller like opencode-tts that always tries to play its output, it gets a
# silent stub so that attempt is a harmless no-op.
set -euo pipefail

SERVER_URL="${TTS_SERVER_URL:-${TTS_FORWARD:-https://tts-tts-ingress.tailf0b7b1.ts.net}}"
VOICE_DEFAULT="zundamon:normal"
# 44-byte silent WAV (0 data bytes) -- see --speak/TTS_FORWARD_MODE above.
SILENT_WAV='\x52\x49\x46\x46\x24\x00\x00\x00\x57\x41\x56\x45\x66\x6d\x74\x20\x10\x00\x00\x00\x01\x00\x01\x00\x40\x1f\x00\x00\x40\x1f\x00\x00\x01\x00\x08\x00\x64\x61\x74\x61\x00\x00\x00\x00'

text="" out="" rate=""
voice="${VOICEVOX_VOICE:-}"
[ "${TTS_FORWARD_MODE:-}" = "speak" ] && speak=1 || speak=0

while [ $# -gt 0 ]; do
  case "$1" in
    --text) text="${2:-}"; shift 2 ;;
    --write-media) out="${2:-}"; shift 2 ;;
    --voice) voice="${2:-}"; shift 2 ;;
    --rate) rate="${2:-}"; shift 2 ;;
    --volume) shift 2 ;;          # accepted for compatibility, ignored
    --speak) speak=1; shift ;;
    --list-voices)
      echo "Voices live on $SERVER_URL — see $SERVER_URL/install"
      exit 0 ;;
    *) echo "tts-forward: ignoring unknown flag $1" >&2; shift ;;
  esac
done

[ -n "$text" ] || { echo "tts-forward: no --text" >&2; exit 2; }
[ "$speak" = 1 ] || [ -n "$out" ] || { echo "tts-forward: no --write-media" >&2; exit 2; }
[ -n "$voice" ] || voice="$VOICE_DEFAULT"

if [ -n "$rate" ]; then
  rate="${rate%%%}"   # "+25%" -> "+25"
  rate="${rate#+}"    # "+25" -> "25"
fi

if [ "$speak" = 1 ]; then
  curl -fsS -m 600 -G "$SERVER_URL/speak" \
    --data-urlencode "text=$text" \
    --data-urlencode "voice=$voice" \
    ${rate:+--data-urlencode "rate=$rate"}
  [ -n "$out" ] && printf "$SILENT_WAV" > "$out"
  exit 0
fi

url="$SERVER_URL/api/tts?voice=$voice"
[ -n "$rate" ] && url="$url&rate=$rate"

tmp="$(mktemp "${TMPDIR:-/tmp}/tts-forward.XXXXXX")"
trap 'rm -f "$tmp"' EXIT

curl -fsS -m 600 -X POST \
  -H 'Content-Type: text/plain' \
  --data-binary "$text" \
  -o "$tmp" "$url"

mv "$tmp" "$out"
