{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "ask",
    "webfetch": "allow",
    "websearch": "allow",
    "todowrite": "allow",
    "bash": {
      "*": "ask",
      "gh auth status *": "allow",
      "gh issue list *": "allow",
      "gh issue view *": "allow",
      "gh pr checks *": "allow",
      "gh pr diff *": "allow",
      "gh pr list *": "allow",
      "gh pr view *": "allow",
      "gh run list *": "allow",
      "gh run view *": "allow",
      "gh run watch *": "allow",
      "git add *": "allow",
      "git check-ignore *": "allow",
      "git diff *": "allow",
      "git fetch *": "allow",
      "git grep *": "allow",
      "git log *": "allow",
      "git ls-files *": "allow",
      "git reflog *": "allow",
      "git rev-list *": "allow",
      "git rev-parse *": "allow",
      "git show *": "allow",
      "git stash list *": "allow",
      "git status *": "allow",
      "grep *": "allow",
      "head *": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "cut *": "allow",
      "echo *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "tr *": "allow",
      "rg *": "allow",
      "cd *": "allow",
      "pwd *": "allow",
      "time *": "allow",
      "nm *": "allow",
      "npm view *": "allow",
      "npm ls *": "allow",
      "pnpm ls *": "allow",
      "sort *": "allow",
      "which *": "allow",
      "file *": "allow",
      "pre-commit *": "allow"
    },
    "glob": "allow",
    "grep": "allow",
    "read": "allow"
  },
  "provider": {
    "opencode-go": {
      "models": {
        "deepseek-v4-flash": {
          "limit": {
            "output": 65536,
            "context": 262144
          }
        }
      }
    }
  },
  "plugin": [
    "opencode-tts"
  ]
}
